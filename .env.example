# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/mudra_publications
MONGODB_DB_NAME=mudra_publications

# Authentication & Session Security
JWT_SECRET=mudra-publications-super-secret-jwt-key-2026-kerala-registration-library
SESSION_COOKIE_NAME=mudra_session
SESSION_MAX_AGE_SECONDS=28800

# Private Object Storage (Local Private Directory outside public/ or S3-compatible bucket)
STORAGE_PROVIDER=local
PRIVATE_STORAGE_ROOT=./private_storage

# Default Bootstrap Accounts (used during initial db:setup / import)
DEFAULT_ADMIN_LOGIN_ID=admin.mudra
DEFAULT_ADMIN_PASSWORD=MudraAdmin@2026!
DEFAULT_READER_LOGIN_ID=reader.kerala
DEFAULT_READER_PASSWORD=MudraReader@2026!
